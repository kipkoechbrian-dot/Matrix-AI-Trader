# ---- Database ----
# Full URL wins when set. Zero-setup option (no PostgreSQL needed):
#   DATABASE_URL=sqlite:///./matrix.db
DATABASE_URL=
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=matrix_ai_trader
DATABASE_USER=matrix_admin
DATABASE_PASSWORD=YOUR_PASSWORD_HERE

# ---- Auth / JWT ----
SECRET_KEY=change-me-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ---- Market data (TwelveData) ----
TWELVE_DATA_API_KEY=

# ---- Frontend ----
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- Email (optional) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=
