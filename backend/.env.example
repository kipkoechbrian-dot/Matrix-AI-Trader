# ---- Database ----
# Full URL wins when set. Zero-setup option (no PostgreSQL needed):
#   DATABASE_URL=sqlite:///./matrix.db
DATABASE_URL=
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=matrix_ai_trader
DATABASE_USER=matrix_admin
DATABASE_PASSWORD=YOUR_PASSWORD_HERE

# ---- Auth / JWT ----
SECRET_KEY=change-me-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ---- Market data (TwelveData) ----
TWELVE_DATA_API_KEY=

# ---- Frontend ----
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- Email (SMTP — receipts for deposits, alerts) ----
# Gmail: enable 2FA, then create an App Password (myaccount.google.com/apppasswords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=you@gmail.com
SMTP_PASSWORD=your-16-char-app-password
EMAIL_FROM=you@gmail.com

# ---- M-Pesa (Safaricom Daraja — live STK pushes) ----
# Get sandbox credentials free at developer.safaricom.co.ke
# Without these, deposits run a faithful demo flow that auto-settles.
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_BASE=https://sandbox.safaricom.co.ke

# ---- Card (Stripe) ----
# Test keys from dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=
